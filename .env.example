# Contact form delivery via Resend (https://resend.com).
# All three are required for /api/contact to send email.
# If any is missing the API returns 503 and the form opens a prefilled mailto: draft instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional. Raises the GitHub API rate limit for /api/github. Read on the server only; never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=
